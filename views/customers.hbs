]


{{!-- Create a table --}}
<table id="customers-table">

    {{!-- Header section --}}
    <thead>
        <tr>
            <th>idCustomer</th>
            <th>name</th>
            <th>phoneNum</th>
            <th>email</th>
            <th>delete</th>
        </tr>
    </thead>


    {{!-- Body section --}}
    <tbody>

        {{#each data}}

        <tr data-value="{{this.idCustomer}}">

            <td>{{this.idCustomer}}</td>

            <td>{{this.name}}</td>

            <td>{{this.phoneNum}}</td>

            <td>{{this.email}}</td>

            <td>
                <button onclick="deleteCustomer({{this.idCustomer}})">
                    Delete
                </button>
            </td>

        </tr>

        {{/each}}

    </tbody>

</table>


{{!-- Embed our JavaScript for deleting Customers --}}
<script src="./js/delete_customer.js"></script>



{{!-- Form to add a record to the table --}}
<h2>Add a New Customer</h2>

<p>
    To add a new customer, please enter their information
    below and click 'Submit'!
</p>

<form id="add-customer-form-ajax">

    <label for="input-name">
        Name:
    </label>

    <input type="text" name="input-name" id="input-name" required>


    <label for="input-phoneNum">
        Phone Number:
    </label>

    <input type="text" name="input-phoneNum" id="input-phoneNum">


    <label for="input-email">
        Email:
    </label>

    <input type="email" name="input-email" id="input-email">


    <input type="submit">

</form>


{{!-- Embed our JavaScript to handle Create --}}
<script src="./js/add_customer.js"></script>



<h2>Updating a Customer's Info</h2>

<p>
    To update a specific customer's information,
    select the customer and enter their updated information below.
</p>

<form id="update-customer-form-ajax">


    <label for="customer-select">
        Customer:
    </label>

    <select name="customer-select" id="customer-select" required>

        <option value="">
            Select a Customer
        </option>

        {{#each data}}

        <option value="{{this.idCustomer}}">
            {{this.name}} (ID {{this.idCustomer}})
        </option>

        {{/each}}

    </select>


    <label for="input-name-update">
        Name:
    </label>

    <input type="text" name="input-name-update" id="input-name-update" required>


    <label for="input-phoneNum-update">
        Phone Number:
    </label>

    <input type="text" name="input-phoneNum-update" id="input-phoneNum-update">


    <label for="input-email-update">
        Email:
    </label>

    <input type="email" name="input-email-update" id="input-email-update">


    <input type="submit">

</form>


{{!-- Embed our JavaScript to handle Update --}}
<script src="./js/update_customer.js"></script>