<!-- Code adapted from nodejs-start-app from course github to fit our database -->

<!-- customers.hbs -->


{{!-- ----------------------------------------------------
PAGE HEADER
----------------------------------------------------- --}}

<section class="page-header">

    <p class="eyebrow">
        Database Management
    </p>

    <h1>
        Customers
    </h1>

    <p class="page-description">
        View, create, update, and remove customer records
        stored in the Unreal Coffee database.
    </p>

</section>



{{!-- ----------------------------------------------------
CUSTOMER TABLE
----------------------------------------------------- --}}

<section class="data-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Records
            </p>

            <h2>
                Customer Directory
            </h2>

            <p>
                These are the customers currently stored
                in the database.
            </p>

        </div>

    </div>


    <div class="table-container">

        <table id="customers-table">

            <thead>

                <tr>

                    <th>
                        Customer ID
                    </th>

                    <th>
                        Name
                    </th>

                    <th>
                        Phone Number
                    </th>

                    <th>
                        Email
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                {{#each data}}

                <tr data-value="{{this.idCustomer}}">

                    <td>
                        {{this.idCustomer}}
                    </td>

                    <td>
                        {{this.name}}
                    </td>

                    <td>
                        {{this.phoneNum}}
                    </td>

                    <td>
                        {{this.email}}
                    </td>

                    <td>

                        <button class="button button-danger" type="button"
                            onclick="deleteCustomer({{this.idCustomer}})">
                            Delete
                        </button>

                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</section>



{{!-- ----------------------------------------------------
CREATE CUSTOMER
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Create
            </p>

            <h2>
                Add a Customer
            </h2>

            <p>
                Add a new customer record to the
                Unreal Coffee database.
            </p>

        </div>

    </div>


    <form id="add-customer-form-ajax" class="data-form">

        <div class="form-group">

            <label for="input-name">
                Name
            </label>

            <input type="text" name="input-name" id="input-name" required>

        </div>


        <div class="form-group">

            <label for="input-phoneNum">
                Phone Number
            </label>

            <input type="text" name="input-phoneNum" id="input-phoneNum">

        </div>


        <div class="form-group">

            <label for="input-email">
                Email
            </label>

            <input type="email" name="input-email" id="input-email">

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Add Customer">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
UPDATE CUSTOMER
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Update
            </p>

            <h2>
                Update a Customer
            </h2>

            <p>
                Select an existing customer and enter
                the information you want to store.
            </p>

        </div>

    </div>


    <form id="update-customer-form-ajax" class="data-form">

        <div class="form-group">

            <label for="customer-select">
                Customer
            </label>

            <select name="customer-select" id="customer-select" required>

                <option value="">
                    Select a Customer
                </option>

                {{#each data}}

                <option value="{{this.idCustomer}}">
                    {{this.name}} (ID {{this.idCustomer}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="input-name-update">
                Name
            </label>

            <input type="text" name="input-name-update" id="input-name-update" required>

        </div>


        <div class="form-group">

            <label for="input-phoneNum-update">
                Phone Number
            </label>

            <input type="text" name="input-phoneNum-update" id="input-phoneNum-update">

        </div>


        <div class="form-group">

            <label for="input-email-update">
                Email
            </label>

            <input type="email" name="input-email-update" id="input-email-update">

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Update Customer">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
PAGE-SPECIFIC JAVASCRIPT
----------------------------------------------------- --}}

<script src="/js/delete_customer.js"></script>

<script src="/js/add_customer.js"></script>

<script src="/js/update_customer.js"></script>