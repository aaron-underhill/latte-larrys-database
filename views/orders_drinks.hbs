{{!--
Orders_Drinks is our intersection/junction table.

Each row represents one Drink belonging to one Order.
quantity tells us how many of that Drink were ordered.
drinkTotal is calculated automatically from:
Drink price * quantity
--}}


{{!-- Create a table --}}
<table id="orders_drinks-table">

    {{!-- Header section --}}
    <thead>

        <tr>
            <th>idOrderDrink</th>
            <th>idOrder</th>
            <th>idDrink</th>
            <th>quantity</th>
            <th>drinkTotal</th>
            <th>delete</th>
        </tr>

    </thead>


    {{!-- Body section --}}
    <tbody>

        {{#each orderDrinkData}}

        <tr data-value="{{this.idOrderDrink}}">

            <td>{{this.idOrderDrink}}</td>

            <td>{{this.idOrder}}</td>

            <td>
                {{this.idDrink}} - {{this.drinkName}}
            </td>

            <td>{{this.quantity}}</td>

            <td>{{this.drinkTotal}}</td>

            <td>
                <button onclick="deleteOrderDrink({{this.idOrderDrink}})">
                    Delete
                </button>
            </td>

        </tr>

        {{/each}}

    </tbody>

</table>


{{!-- Embed JavaScript for deleting Order-Drink relationships --}}
<script src="./js/delete_order_drink.js"></script>



{{!-- Form to add a Drink to an Order --}}
<h2>Add a Drink to an Order</h2>

<p>
    Select an Order, select a Drink, and enter the quantity.
    The Drink total and the Order's total price will be
    calculated automatically.
</p>


<form id="add-order_drink-form-ajax">


    <label for="input-order">
        Order:
    </label>

    <select name="input-order" id="input-order" required>

        <option value="">
            Select an Order
        </option>

        {{#each orderData}}

        <option value="{{this.idOrder}}">
            Order {{this.idOrder}}
        </option>

        {{/each}}

    </select>


    <label for="input-drink">
        Drink:
    </label>

    <select name="input-drink" id="input-drink" required>

        <option value="">
            Select a Drink
        </option>

        {{#each drinkData}}

        <option value="{{this.idDrink}}">
            {{this.name}} - ${{this.price}} (ID {{this.idDrink}})
        </option>

        {{/each}}

    </select>


    <label for="input-quantity">
        Quantity:
    </label>

    <input type="number" name="input-quantity" id="input-quantity" min="1" step="1" required>


    <input type="submit">

</form>


{{!-- Embed JavaScript to handle Create --}}
<script src="./js/add_order_drink.js"></script>



<h2>Updating an Order-Drink</h2>

<p>
    Select an Order-Drink relationship and change its Order,
    Drink, or quantity. Pricing will be recalculated automatically.
</p>


<form id="update-order_drink-form-ajax">


    <label for="order-drink-select">
        Order-Drink:
    </label>

    <select name="order-drink-select" id="order-drink-select" required>

        <option value="">
            Select an Order-Drink
        </option>

        {{#each orderDrinkData}}

        <option value="{{this.idOrderDrink}}">
            Order {{this.idOrder}}:
            {{this.drinkName}}
            (Line {{this.idOrderDrink}})
        </option>

        {{/each}}

    </select>


    <label for="update-order">
        Order:
    </label>

    <select name="update-order" id="update-order" required>

        <option value="">
            Select an Order
        </option>

        {{#each orderData}}

        <option value="{{this.idOrder}}">
            Order {{this.idOrder}}
        </option>

        {{/each}}

    </select>


    <label for="update-drink">
        Drink:
    </label>

    <select name="update-drink" id="update-drink" required>

        <option value="">
            Select a Drink
        </option>

        {{#each drinkData}}

        <option value="{{this.idDrink}}">
            {{this.name}} - ${{this.price}} (ID {{this.idDrink}})
        </option>

        {{/each}}

    </select>


    <label for="update-quantity">
        Quantity:
    </label>

    <input type="number" name="update-quantity" id="update-quantity" min="1" step="1" required>


    <input type="submit">

</form>


{{!-- Embed JavaScript to handle Update --}}
<script src="./js/update_order_drink.js"></script>