<!-- Code adapted from nodejs-start-app from course github to fit our database -->

<!-- orders_drinks.hbs -->


{{!-- ----------------------------------------------------
PAGE HEADER
----------------------------------------------------- --}}

<section class="page-header">

    <p class="eyebrow">
        Database Management
    </p>

    <h1>
        Order Items
    </h1>

    <p class="page-description">
        Manage the drinks and quantities associated with
        individual Unreal Coffee orders.
    </p>

</section>



{{!-- ----------------------------------------------------
ORDER ITEMS TABLE
----------------------------------------------------- --}}

<section class="data-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Records
            </p>

            <h2>
                Order Item Directory
            </h2>

            <p>
                Each record represents a drink belonging
                to a specific order.
            </p>

            <p class="section-note">
                Line totals are calculated automatically
                from the selected drink price and quantity.
            </p>

        </div>

    </div>


    <div class="table-container">

        <table id="orders_drinks-table">

            <thead>

                <tr>

                    <th>
                        Item ID
                    </th>

                    <th>
                        Order ID
                    </th>

                    <th>
                        Drink
                    </th>

                    <th>
                        Quantity
                    </th>

                    <th>
                        Line Total
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                {{#each orderDrinkData}}

                <tr data-value="{{this.idOrderDrink}}">

                    <td>
                        {{this.idOrderDrink}}
                    </td>

                    <td>
                        {{this.idOrder}}
                    </td>

                    <td>
                        {{this.idDrink}} - {{this.drinkName}}
                    </td>

                    <td>
                        {{this.quantity}}
                    </td>

                    <td>
                        ${{this.drinkTotal}}
                    </td>

                    <td>

                        <button class="button button-danger" type="button"
                            onclick="deleteOrderDrink({{this.idOrderDrink}})">
                            Delete
                        </button>

                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</section>



{{!-- ----------------------------------------------------
CREATE ORDER ITEM
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Create
            </p>

            <h2>
                Add an Order Item
            </h2>

            <p>
                Add a drink to an existing order and
                specify how many were ordered.
            </p>

            <p class="section-note">
                The line total and the parent order's total
                price are calculated automatically.
            </p>

        </div>

    </div>


    <form id="add-order_drink-form-ajax" class="data-form">

        <div class="form-group">

            <label for="input-order">
                Order
            </label>

            <select name="input-order" id="input-order" required>

                <option value="">
                    Select an Order
                </option>

                {{#each orderData}}

                <option value="{{this.idOrder}}">
                    Order {{this.idOrder}}
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="input-drink">
                Drink
            </label>

            <select name="input-drink" id="input-drink" required>

                <option value="">
                    Select a Drink
                </option>

                {{#each drinkData}}

                <option value="{{this.idDrink}}">
                    {{this.name}} - ${{this.price}} (ID {{this.idDrink}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="input-quantity">
                Quantity
            </label>

            <input type="number" name="input-quantity" id="input-quantity" min="1" step="1" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Add Order Item">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
UPDATE ORDER ITEM
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Update
            </p>

            <h2>
                Update an Order Item
            </h2>

            <p>
                Select an existing order item and change
                its order, drink, or quantity.
            </p>

            <p class="section-note">
                Pricing is recalculated automatically
                after the item is updated.
            </p>

        </div>

    </div>


    <form id="update-order_drink-form-ajax" class="data-form">

        <div class="form-group">

            <label for="order-drink-select">
                Order Item
            </label>

            <select name="order-drink-select" id="order-drink-select" required>

                <option value="">
                    Select an Order Item
                </option>

                {{#each orderDrinkData}}

                <option value="{{this.idOrderDrink}}">
                    Order {{this.idOrder}}:
                    {{this.drinkName}}
                    (Item {{this.idOrderDrink}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="update-order">
                Order
            </label>

            <select name="update-order" id="update-order" required>

                <option value="">
                    Select an Order
                </option>

                {{#each orderData}}

                <option value="{{this.idOrder}}">
                    Order {{this.idOrder}}
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="update-drink">
                Drink
            </label>

            <select name="update-drink" id="update-drink" required>

                <option value="">
                    Select a Drink
                </option>

                {{#each drinkData}}

                <option value="{{this.idDrink}}">
                    {{this.name}} - ${{this.price}} (ID {{this.idDrink}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="update-quantity">
                Quantity
            </label>

            <input type="number" name="update-quantity" id="update-quantity" min="1" step="1" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Update Order Item">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
PAGE-SPECIFIC JAVASCRIPT
----------------------------------------------------- --}}

<script src="/js/delete_order_drink.js"></script>

<script src="/js/add_order_drink.js"></script>

<script src="/js/update_order_drink.js"></script>