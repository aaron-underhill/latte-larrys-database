<!-- Code adapted from nodejs-start-app from course github to fit our database -->

<!-- orders.hbs -->
<title>Orders</title>
<h1>Orders</h1>
<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>

[ <a href="/">Home</a> | <a href="/employees">Employees</a> 
| <a href="/customers">Customers</a> 
| <a href="/orders">Orders</a> | <a href="/drinks">Drinks</a>
| <a href="/orders_drinks">Orders_Drinks</a>  ]

{{!-- Create a table --}}
<table id="orders-table">

    {{!-- Header section --}}
    <thead>

        {{!-- For just the first row, we print each key of the row object as a header cell so we
        know what each column means when the page renders --}}
        <tr>
            {{#each orderData.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th>delete</th>
        </tr>
    </thead>

    {{!-- Body section --}}
    <tbody>

        {{#each orderData}}
        <tr data-value={{this.idOrder}}>
            <td>{{this.idOrder}}</td>
            <td>{{this.idEmployee}}</td>
            <td>{{this.idCustomer}}</td>
            <td>{{this.totalPrice}}</td>
            <td>{{this.minutesToProcess}}</td>
            <td>{{this.orderDate}}</td>
            <td><button onclick="deleteOrder({{this.idOrder}})">Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>
<script src="./js/delete_order.js"></script> 


{{!-- Form to add a record to the table  --}}
<h2>Add a New Order</h2>
<p>To add a new order, please enter the information below and click 'Submit'!</p>
<form id="add-order-form-ajax">

    <label for="input-employee">Employee: </label>
    <select name="input-employee" id="input-employee">
        <option value="employee">Select an Employee</option>
        {{#each employeeData}}
        <option value="{{this.idEmployee}}">{{this.idEmployee}}</option>
        {{/each}}
    </select>

    <label for="input-customer">Customer: </label>
    <select name="input-customer" id="input-customer">
        <option value="test">Select a Customer</option>
        {{#each customerData}}
        <option value="{{this.idCustomer}}">{{this.idCustomer}}</option>
        {{/each}}
    </select>

    <label for="input-minutesToProcess">Minutes Taken To Process: </label>
    <input type="text" name="input-minutesToProcess" id="input-minutesToProcess">
    
    <label for="input-date">Order Date: </label>
    <input type="date" name="input-date" id="input-date">
    
    <input type="submit">
</form> 

{{!-- Embed our javascript to handle the DOM manipulation and AJAX request --}}
<script src="./js/add_order.js"></script>


<h2>Updating an Order's Info </h2>
<p>To update a specific order's info, fill out the fields below. Refresh page after submitting.</p>
<form id="update-order-form-ajax">

    <label for="update-order">Order: </label>
    <select name="update-order" id="update-order">
        <option value="test">Select an Order</option>
        {{#each orderData}}
        <option value="{{this.idOrder}}">{{this.idOrder}}</option>
        {{/each}}
    </select>

    <label for="update-employee">Employee: </label>
    <select name="update-employee" id="update-employee">
        <option value="employee">Select an Employee</option>
        {{#each employeeData}}
        <option value="{{this.idEmployee}}">{{this.idEmployee}}</option>
        {{/each}}
    </select>

    <label for="update-customer">Customer: </label>
    <select name="update-customer" id="update-customer">
        <option value="test">Select a Customer</option>
        {{#each customerData}}
        <option value="{{this.idCustomer}}">{{this.idCustomer}}</option>
        {{/each}}
    </select>

    <label for="update-minutesToProcess">Minutes Taken To Process: </label>
    <input type="text" name="update-minutesToProcess" id="update-minutesToProcess">
    
    <label for="update-date">Order Date: </label>
    <input type="date" name="update-date" id="update-date">

    <input type="submit">

</form>

<script src="./js/update_order.js"></script>