<!-- Code adapted from nodejs-start-app from course github to fit our database -->

<!-- orders.hbs -->


{{!-- ----------------------------------------------------
PAGE HEADER
----------------------------------------------------- --}}

<section class="page-header">

    <p class="eyebrow">
        Database Management
    </p>

    <h1>
        Orders
    </h1>

    <p class="page-description">
        View, create, update, and remove customer orders
        stored in the Unreal Coffee database.
    </p>

</section>



{{!-- ----------------------------------------------------
ORDER TABLE
----------------------------------------------------- --}}

<section class="data-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Records
            </p>

            <h2>
                Order History
            </h2>

            <p>
                These are the orders currently stored
                in the database.
            </p>

        </div>

    </div>


    <div class="table-container">

        <table id="orders-table">

            <thead>

                <tr>

                    <th>
                        Order ID
                    </th>

                    <th>
                        Employee ID
                    </th>

                    <th>
                        Customer ID
                    </th>

                    <th>
                        Total Price
                    </th>

                    <th>
                        Processing Time
                    </th>

                    <th>
                        Order Date
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                {{#each orderData}}

                <tr data-value="{{this.idOrder}}">

                    <td>
                        {{this.idOrder}}
                    </td>

                    <td>
                        {{this.idEmployee}}
                    </td>

                    <td>
                        {{this.idCustomer}}
                    </td>

                    <td>
                        ${{this.totalPrice}}
                    </td>

                    <td>
                        {{this.minutesToProcess}} min
                    </td>

                    <td>
                        {{this.orderDate}}
                    </td>

                    <td>

                        <button class="button button-danger" type="button" onclick="deleteOrder({{this.idOrder}})">
                            Delete
                        </button>

                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</section>



{{!-- ----------------------------------------------------
CREATE ORDER
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Create
            </p>

            <h2>
                Add an Order
            </h2>

            <p>
                Create a new order by selecting an employee
                and customer, entering the processing time,
                and choosing the order date.
            </p>

            <p class="section-note">
                The order total begins at $0.00 and is
                calculated automatically as Order Items
                are added.
            </p>

        </div>

    </div>


    <form id="add-order-form-ajax" class="data-form">

        <div class="form-group">

            <label for="input-employee">
                Employee
            </label>

            <select name="input-employee" id="input-employee" required>

                <option value="">
                    Select an Employee
                </option>

                {{#each employeeData}}

                <option value="{{this.idEmployee}}">
                    {{this.name}} (ID {{this.idEmployee}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="input-customer">
                Customer
            </label>

            <select name="input-customer" id="input-customer" required>

                <option value="">
                    Select a Customer
                </option>

                {{#each customerData}}

                <option value="{{this.idCustomer}}">
                    {{this.name}} (ID {{this.idCustomer}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="input-minutesToProcess">
                Processing Time
            </label>

            <input type="number" name="input-minutesToProcess" id="input-minutesToProcess" min="0" step="0.1" required>

        </div>


        <div class="form-group">

            <label for="input-date">
                Order Date
            </label>

            <input type="date" name="input-date" id="input-date" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Add Order">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
UPDATE ORDER
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Update
            </p>

            <h2>
                Update an Order
            </h2>

            <p>
                Select an existing order and enter the
                information you want to store.
            </p>

            <p class="section-note">
                Total price is managed automatically from
                the Order Items belonging to this order.
            </p>

        </div>

    </div>


    <form id="update-order-form-ajax" class="data-form">

        <div class="form-group">

            <label for="order-select">
                Order
            </label>

            <select name="order-select" id="order-select" required>

                <option value="">
                    Select an Order
                </option>

                {{#each orderData}}

                <option value="{{this.idOrder}}">
                    Order {{this.idOrder}}
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="update-employee">
                Employee
            </label>

            <select name="update-employee" id="update-employee" required>

                <option value="">
                    Select an Employee
                </option>

                {{#each employeeData}}

                <option value="{{this.idEmployee}}">
                    {{this.name}} (ID {{this.idEmployee}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="update-customer">
                Customer
            </label>

            <select name="update-customer" id="update-customer" required>

                <option value="">
                    Select a Customer
                </option>

                {{#each customerData}}

                <option value="{{this.idCustomer}}">
                    {{this.name}} (ID {{this.idCustomer}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="update-minutesToProcess">
                Processing Time
            </label>

            <input type="number" name="update-minutesToProcess" id="update-minutesToProcess" min="0" step="0.1"
                required>

        </div>


        <div class="form-group">

            <label for="update-date">
                Order Date
            </label>

            <input type="date" name="update-date" id="update-date" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Update Order">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
PAGE-SPECIFIC JAVASCRIPT
----------------------------------------------------- --}}

<script src="/js/delete_order.js"></script>

<script src="/js/add_order.js"></script>

<script src="/js/update_order.js"></script>