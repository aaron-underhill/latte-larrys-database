]


{{!-- Create a table --}}
<table id="drinks-table">

    {{!-- Header section --}}
    <thead>
        <tr>
            <th>idDrink</th>
            <th>name</th>
            <th>description</th>
            <th>price</th>
            <th>delete</th>
        </tr>
    </thead>


    {{!-- Body section --}}
    <tbody>

        {{#each data}}

        <tr data-value="{{this.idDrink}}">

            <td>{{this.idDrink}}</td>

            <td>{{this.name}}</td>

            <td>{{this.description}}</td>

            <td>{{this.price}}</td>

            <td>
                <button onclick="deleteDrink({{this.idDrink}})">
                    Delete
                </button>
            </td>

        </tr>

        {{/each}}

    </tbody>

</table>


{{!-- Embed our JavaScript for deleting Drinks --}}
<script src="./js/delete_drink.js"></script>



{{!-- Form to add a record to the table --}}
<h2>Add a New Drink</h2>

<p>
    To add a new drink, please enter its information
    below and click 'Submit'!
</p>

<form id="add-drink-form-ajax">

    <label for="input-name">
        Name:
    </label>

    <input type="text" name="input-name" id="input-name" required>


    <label for="input-description">
        Description:
    </label>

    <input type="text" name="input-description" id="input-description" required>


    <label for="input-price">
        Price: $
    </label>

    <input type="number" name="input-price" id="input-price" min="0" step="0.01" required>


    <input type="submit">

</form>


{{!-- Embed our JavaScript to handle Create --}}
<script src="./js/add_drink.js"></script>



<h2>Updating a Drink's Info</h2>

<p>
    To update a specific drink's information,
    select the drink and enter its updated information below.
</p>

<form id="update-drink-form-ajax">


    <label for="drink-select">
        Drink:
    </label>

    <select name="drink-select" id="drink-select" required>

        <option value="">
            Select a Drink
        </option>

        {{#each data}}

        <option value="{{this.idDrink}}">
            {{this.name}} (ID {{this.idDrink}})
        </option>

        {{/each}}

    </select>


    <label for="input-name-update">
        Name:
    </label>

    <input type="text" name="input-name-update" id="input-name-update" required>


    <label for="input-description-update">
        Description:
    </label>

    <input type="text" name="input-description-update" id="input-description-update" required>


    <label for="input-price-update">
        Price: $
    </label>

    <input type="number" name="input-price-update" id="input-price-update" min="0" step="0.01" required>


    <input type="submit">

</form>


{{!-- Embed our JavaScript to handle Update --}}
<script src="./js/update_drink.js"></script>