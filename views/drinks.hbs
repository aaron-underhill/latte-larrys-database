<!-- Code adapted from nodejs-start-app from course github to fit our database -->

<!-- drinks.hbs -->


{{!-- ----------------------------------------------------
PAGE HEADER
----------------------------------------------------- --}}

<section class="page-header">

    <p class="eyebrow">
        Database Management
    </p>

    <h1>
        Drinks
    </h1>

    <p class="page-description">
        View, create, update, and remove drinks
        available through the Unreal Coffee database.
    </p>

</section>



{{!-- ----------------------------------------------------
DRINK TABLE
----------------------------------------------------- --}}

<section class="data-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Records
            </p>

            <h2>
                Drink Menu
            </h2>

            <p>
                These are the drinks currently stored
                in the database.
            </p>

        </div>

    </div>


    <div class="table-container">

        <table id="drinks-table">

            <thead>

                <tr>

                    <th>
                        Drink ID
                    </th>

                    <th>
                        Name
                    </th>

                    <th>
                        Description
                    </th>

                    <th>
                        Price
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                {{#each data}}

                <tr data-value="{{this.idDrink}}">

                    <td>
                        {{this.idDrink}}
                    </td>

                    <td>
                        {{this.name}}
                    </td>

                    <td>
                        {{this.description}}
                    </td>

                    <td>
                        ${{this.price}}
                    </td>

                    <td>

                        <button class="button button-danger" type="button" onclick="deleteDrink({{this.idDrink}})">
                            Delete
                        </button>

                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</section>



{{!-- ----------------------------------------------------
CREATE DRINK
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Create
            </p>

            <h2>
                Add a Drink
            </h2>

            <p>
                Add a new drink to the
                Unreal Coffee menu.
            </p>

        </div>

    </div>


    <form id="add-drink-form-ajax" class="data-form">

        <div class="form-group">

            <label for="input-name">
                Name
            </label>

            <input type="text" name="input-name" id="input-name" required>

        </div>


        <div class="form-group">

            <label for="input-description">
                Description
            </label>

            <input type="text" name="input-description" id="input-description" required>

        </div>


        <div class="form-group">

            <label for="input-price">
                Price
            </label>

            <input type="number" name="input-price" id="input-price" min="0" step="0.01" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Add Drink">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
UPDATE DRINK
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Update
            </p>

            <h2>
                Update a Drink
            </h2>

            <p>
                Select an existing drink and enter
                the information you want to store.
            </p>

        </div>

    </div>


    <form id="update-drink-form-ajax" class="data-form">

        <div class="form-group">

            <label for="drink-select">
                Drink
            </label>

            <select name="drink-select" id="drink-select" required>

                <option value="">
                    Select a Drink
                </option>

                {{#each data}}

                <option value="{{this.idDrink}}">
                    {{this.name}} (ID {{this.idDrink}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="input-name-update">
                Name
            </label>

            <input type="text" name="input-name-update" id="input-name-update" required>

        </div>


        <div class="form-group">

            <label for="input-description-update">
                Description
            </label>

            <input type="text" name="input-description-update" id="input-description-update" required>

        </div>


        <div class="form-group">

            <label for="input-price-update">
                Price
            </label>

            <input type="number" name="input-price-update" id="input-price-update" min="0" step="0.01" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Update Drink">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
PAGE-SPECIFIC JAVASCRIPT
----------------------------------------------------- --}}

<script src="/js/delete_drink.js"></script>

<script src="/js/add_drink.js"></script>

<script src="/js/update_drink.js"></script>