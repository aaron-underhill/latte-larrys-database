<!-- Code adapted from nodejs-start-app from course github to fit our database -->

<!-- employees.hbs -->
<title>Employees</title>
<h1>Employees</h1>
<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>

[ <a href="/">Home</a> | <a href="/employees">Employees</a> 
| <a href="/customers">Customers</a> 
| <a href="/orders">Orders</a> | <a href="/drinks">Drinks</a>
| <a href="/orders_drinks">Orders_Drinks</a>  ]

{{!-- Create a table --}}
<table id="employees-table">

    {{!-- Header section --}}
    <thead>

        {{!-- For just the first row, we print each key of the row object as a header cell so we
        know what each column means when the page renders --}}
        <tr>
            {{#each data.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th>delete</th>
        </tr>
    </thead>

    {{!-- Body section --}}
    <tbody>

        {{#each data}}
        <tr data-value={{this.idEmployee}}>
            <td>{{this.idPassword}}</td>
            <td>{{this.idEmployee}}</td>
            <td>{{this.name}}</td>
            <td>{{this.phoneNum}}</td>
            <td>{{this.email}}</td>
            <td>{{this.address}}</td>
            <td><button onclick="deleteEmployee({{this.idEmployee}})">Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>
<script src="./js/delete_employee.js"></script>


{{!-- Form to add a record to the table  --}}
<h2>Add a New Employee</h2>
<p>To add a new employee, please enter their information below and click 'Submit'! Refresh page after submitting.</p>
<form id="add-employee-form-ajax">
    <label for="input-name">Name: </label>
    <input type="text" name="input-name" id="input-name">

    <label for="input-password">Password ID: </label>
    <input type="text" name="input-password" id="input-password">
    
    <label for="input-phoneNum">Phone Number: </label>
    <input type="text" name="input-phoneNum" id="input-phoneNum">


    <label for="input-email">Email: </label>
    <input type="text" name="input-email" id="input-email">

    <label for="input-address">Address: </label>
    <input type="text" name="input-address" id="input-address">

    <input type="submit">
</form>

{{!-- Embed our javascript to handle the DOM manipulation and AJAX request --}}
<script src="./js/add_employee.js"></script>


<h2>Updating an Employee's Info </h2>
<p>To update a specific employee's info, fill out the fields below. Refresh page after submitting.</p>
<form id="update-employee-form-ajax">

    <label for="input-name">Employee ID: </label>
    <select name="input-name" id="mySelect">
        <option value="test">Select an Employee</option>
        {{#each data}}
        <option value="{{this.idEmployee}}">{{this.idEmployee}}</option>
        {{/each}}
    </select>

    <label for="input-phoneNum-update">Phone Number: </label>
    <input type="text" name="input-phoneNum-update" id="input-phoneNum-update">

    <label for="input-email-update">Email: </label>
    <input type="text" name="input-email-update" id="input-email-update">

    <label for="input-address-update">Address: </label>
    <input type="text" name="input-address-update" id="input-address-update">


    <input type="submit">

</form>

<script src="./js/update_employee.js"></script>

