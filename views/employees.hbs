<!-- Code adapted from nodejs-start-app from course github to fit our database -->

<!-- employees.hbs -->


{{!-- ----------------------------------------------------
PAGE HEADER
----------------------------------------------------- --}}

<section class="page-header">

    <p class="eyebrow">
        Database Management
    </p>

    <h1>
        Employees
    </h1>

    <p class="page-description">
        View, create, update, and remove employee records
        stored in the Unreal Coffee database.
    </p>

</section>



{{!-- ----------------------------------------------------
EMPLOYEE TABLE
----------------------------------------------------- --}}

<section class="data-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Records
            </p>

            <h2>
                Employee Directory
            </h2>

            <p>
                These are the employees currently stored
                in the database.
            </p>

        </div>

    </div>


    <div class="table-container">

        <table id="employees-table">

            <thead>

                <tr>

                    <th>
                        Employee ID
                    </th>

                    <th>
                        Password ID
                    </th>

                    <th>
                        Name
                    </th>

                    <th>
                        Phone Number
                    </th>

                    <th>
                        Email
                    </th>

                    <th>
                        Address
                    </th>

                    <th>
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                {{#each data}}

                <tr data-value="{{this.idEmployee}}">

                    <td>
                        {{this.idEmployee}}
                    </td>

                    <td>
                        {{this.idPassword}}
                    </td>

                    <td>
                        {{this.name}}
                    </td>

                    <td>
                        {{this.phoneNum}}
                    </td>

                    <td>
                        {{this.email}}
                    </td>

                    <td>
                        {{this.address}}
                    </td>

                    <td>

                        <button class="button button-danger" type="button"
                            onclick="deleteEmployee({{this.idEmployee}})">
                            Delete
                        </button>

                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</section>



{{!-- ----------------------------------------------------
CREATE EMPLOYEE
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Create
            </p>

            <h2>
                Add an Employee
            </h2>

            <p>
                Add a new employee record to the
                Unreal Coffee database.
            </p>

        </div>

    </div>


    <form id="add-employee-form-ajax" class="data-form">

        <div class="form-group">

            <label for="input-name">
                Name
            </label>

            <input type="text" name="input-name" id="input-name" required>

        </div>


        <div class="form-group">

            <label for="input-password">
                Password
            </label>

            <input type="password" name="input-password" id="input-password" required>

        </div>


        <div class="form-group">

            <label for="input-phoneNum">
                Phone Number
            </label>

            <input type="text" name="input-phoneNum" id="input-phoneNum" required>

        </div>


        <div class="form-group">

            <label for="input-email">
                Email
            </label>

            <input type="email" name="input-email" id="input-email" required>

        </div>


        <div class="form-group">

            <label for="input-address">
                Address
            </label>

            <input type="text" name="input-address" id="input-address" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Add Employee">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
UPDATE EMPLOYEE
----------------------------------------------------- --}}

<section class="form-section">

    <div class="section-heading">

        <div>

            <p class="eyebrow">
                Update
            </p>

            <h2>
                Update an Employee
            </h2>

            <p>
                Select an existing employee and enter
                the information you want to store.
            </p>

        </div>

    </div>


    <form id="update-employee-form-ajax" class="data-form">

        <div class="form-group">

            <label for="employee-select">
                Employee
            </label>

            <select name="employee-select" id="employee-select" required>

                <option value="">
                    Select an Employee
                </option>

                {{#each data}}

                <option value="{{this.idEmployee}}">
                    {{this.name}} (ID {{this.idEmployee}})
                </option>

                {{/each}}

            </select>

        </div>


        <div class="form-group">

            <label for="input-name-update">
                Name
            </label>

            <input type="text" name="input-name-update" id="input-name-update" required>

        </div>


        <div class="form-group">

            <label for="input-phoneNum-update">
                Phone Number
            </label>

            <input type="text" name="input-phoneNum-update" id="input-phoneNum-update" required>

        </div>


        <div class="form-group">

            <label for="input-email-update">
                Email
            </label>

            <input type="email" name="input-email-update" id="input-email-update" required>

        </div>


        <div class="form-group">

            <label for="input-address-update">
                Address
            </label>

            <input type="text" name="input-address-update" id="input-address-update" required>

        </div>


        <div class="form-actions">

            <input class="button button-primary" type="submit" value="Update Employee">

        </div>

    </form>

</section>



{{!-- ----------------------------------------------------
PAGE-SPECIFIC JAVASCRIPT
----------------------------------------------------- --}}

<script src="/js/delete_employee.js"></script>

<script src="/js/add_employee.js"></script>

<script src="/js/update_employee.js"></script>